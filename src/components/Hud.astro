---
// The visor: pillar cells, the banner, the clock and frame counter above; readout slates, a waveform
// gauge, the manifest, the projects and the boot log around the instrument; a compass tape and a notice
// strip below. Everything here is static markup and CSS; hud.ts keeps the clock and the counter running.
import Instrument from './Instrument.astro';
import copy from '../content/copy.yml';
import { site } from '../config/site';

const host = (url: string) => url.replace(/^https?:\/\//, '');
const links: Record<string, string> = { github: site.github, docs: site.docs, status: site.status };

interface Row {
  key: string;
  value?: string;
  link?: string;
}
interface Slate {
  title: string;
  rows: Row[];
}
interface Item {
  name: string;
  note: string;
}
const hud = copy.hud as {
  bannerLabel: string;
  banner: string;
  cells: string[];
  gauge: string;
  nodes: { title: string; active: string };
  source: Slate;
  privacy: Slate;
  hosting: Slate;
  manifest: { title: string; items: Item[] };
  projects: { title: string; items: Item[] };
  log: Slate;
  notice: string[];
};

// the compass tape: three identical segments so the loop has no seam
const tape = Array.from({ length: 24 }, (_, k) => String(k * 15).padStart(3, '0'));
const glyphs = ['hex', 'diamond', 'ring', 'triangle'];
---

<div class="hud">
  <div class="top">
    <ul class="cells" aria-hidden="true">
      {
        hud.cells.map((label, i) => (
          <li class="cell" data-l={label}>
            <svg viewBox="0 0 24 24">
              {glyphs[i] === 'hex' && <polygon points="12,2 21,7 21,17 12,22 3,17 3,7" />}
              {glyphs[i] === 'diamond' && <rect x="4" y="4" width="16" height="16" transform="rotate(45 12 12)" />}
              {glyphs[i] === 'ring' && (
                <>
                  <circle cx="12" cy="12" r="8" />
                  <circle cx="12" cy="12" r="2" />
                </>
              )}
              {glyphs[i] === 'triangle' && <polygon points="12,3 21,20 3,20" />}
            </svg>
          </li>
        ))
      }
    </ul>
    <p class="banner">
      <span class="lbl">{hud.bannerLabel}</span>
      <strong>{hud.banner}</strong>
    </p>
    <div class="cells right">
      <span class="cell wide" id="hud-clock">00:00:00 UTC</span>
      <span class="cell wide" id="hud-frame" aria-hidden="true">0x00000</span>
    </div>
  </div>

  <div class="mid">
    <div class="col">
      <section class="slate">
        <h2>{hud.source.title}</h2>
        <dl>
          {
            hud.source.rows.map((r) => (
              <div>
                <dt>{r.key}</dt>
                <dd>
                  {r.link ? (
                    <a href={links[r.link]} rel="noopener noreferrer">
                      {r.value ?? host(links[r.link])}
                    </a>
                  ) : (
                    r.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
      <div class="gauge" data-l={hud.gauge} aria-hidden="true">
        {Array.from({ length: 28 }).map(() => <i />)}
      </div>
      <section class="slate">
        <h2>{hud.privacy.title}</h2>
        <dl>
          {
            hud.privacy.rows.map((r) => (
              <div>
                <dt>{r.key}</dt>
                <dd>{r.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section class="slate nodes">
        <h2>{hud.nodes.title}</h2>
        <a href="#pillars">{copy.pillars.items.length} {hud.nodes.active}</a>
      </section>
    </div>

    <div class="stage">
      <span class="c3"></span><span class="c4"></span>
      <Instrument />
    </div>

    <div class="col">
      <section class="slate">
        <h2>{hud.hosting.title}</h2>
        <dl>
          {
            hud.hosting.rows.map((r) => (
              <div>
                <dt>{r.key}</dt>
                <dd>
                  {r.link ? (
                    <a href={links[r.link]} rel="noopener noreferrer">
                      {r.value ?? host(links[r.link])}
                    </a>
                  ) : (
                    r.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section class="slate">
        <h2>{hud.manifest.title}</h2>
        <div class="ticker four">
          <ul>
            {
              [...hud.manifest.items, hud.manifest.items[0]].map((it) => (
                <li>
                  <b>{it.name}</b> {it.note}
                </li>
              ))
            }
          </ul>
        </div>
      </section>
      <section class="slate">
        <h2>{hud.projects.title}</h2>
        <div class="ticker six">
          <ul>
            {
              [...hud.projects.items, hud.projects.items[0]].map((it) => (
                <li>
                  <a href={`${site.github}/${it.name}`} rel="noopener noreferrer">{it.name}</a> {it.note}
                </li>
              ))
            }
          </ul>
        </div>
      </section>
      <section class="log">
        <h2>{hud.log.title}</h2>
        <ol>
          {
            hud.log.rows.map((r) => (
              <li>
                <span>{r.key}</span>
                <span class="d">................................</span>
                <span class="v">{r.value}</span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <div class="tape" aria-hidden="true">
    <div class="strip">
      {
        [0, 1, 2].map(() => (
          <div class="seg">{tape.map((v) => <span>{v}</span>)}</div>
        ))
      }
    </div>
  </div>
  <div class="notice" aria-hidden="true">
    <div>{[...hud.notice, ...hud.notice].map((t) => <span>{t}</span>)}</div>
  </div>
</div>

<script>
  import '../scripts/hud';
</script>

<style>
  .hud {
    position: relative;
    display: grid;
    gap: var(--space-l);
    animation: flicker 7s steps(1) infinite;
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
    }
    3% {
      opacity: 0.96;
    }
    3.4% {
      opacity: 1;
    }
    41% {
      opacity: 1;
    }
    41.3% {
      opacity: 0.92;
    }
    41.6% {
      opacity: 1;
    }
    77% {
      opacity: 1;
    }
    77.2% {
      opacity: 0.97;
    }
    77.5% {
      opacity: 1;
    }
  }

  /* ── top row ─────────────────────────────────────────── */
  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-m);
  }

  .cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* keep the row clear of the fixed theme toggle in the top right corner */
  @media (min-width: 961px) {
    .top {
      padding-right: 3.25rem;
    }
  }

  .cells.right {
    justify-content: end;
  }

  .cell {
    position: relative;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    animation: cell 6s ease-in-out infinite;
  }

  .cell:nth-child(2) {
    animation-delay: 1.5s;
  }
  .cell:nth-child(3) {
    animation-delay: 3s;
  }
  .cell:nth-child(4) {
    animation-delay: 4.5s;
  }

  .cell svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  .cell::after {
    content: attr(data-l);
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 0.2rem;
    text-align: center;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @keyframes cell {
    0%,
    60%,
    100% {
      box-shadow: none;
    }
    8%,
    45% {
      box-shadow:
        inset 0 0 0 1px var(--accent),
        var(--glow-small);
    }
  }

  .cell.wide {
    width: auto;
    padding: 0 0.75rem;
    white-space: nowrap;
    animation: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .cell.wide::after {
    content: none;
  }


  .banner {
    position: relative;
    padding: 0.55rem 1.6rem 0.65rem;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    text-align: center;
  }

  .banner::before,
  .banner::after {
    content: '';
    position: absolute;
    top: -1px;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--accent);
  }

  .banner::before {
    left: -1px;
    border-left: 2px solid var(--accent);
  }

  .banner::after {
    right: -1px;
    border-right: 2px solid var(--accent);
  }

  .banner .lbl {
    display: block;
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .banner strong {
    display: block;
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: clamp(0.85rem, 0.65rem + 0.9vw, 1.3rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    text-shadow: var(--glow-text);
    animation: glitch 9s steps(1) infinite;
  }

  @keyframes glitch {
    0%,
    92%,
    100% {
      transform: none;
    }
    93% {
      transform: translateX(-3px);
    }
    94% {
      transform: translateX(3px) skewX(8deg);
    }
    95% {
      transform: none;
    }
  }

  /* ── middle row ──────────────────────────────────────── */
  .mid {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr);
    gap: var(--space-l) var(--space-l);
    align-items: center;
  }

  .col {
    display: grid;
    gap: 0.9rem;
    align-content: center;
    min-width: 0;
  }

  .stage {
    position: relative;
    width: min(66vmin, 560px);
    max-width: 100%;
    padding: 1.2rem;
    margin-inline: auto;
  }

  .stage::before,
  .stage::after,
  .stage .c3,
  .stage .c4 {
    content: '';
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--accent);
    border-style: solid;
  }

  .stage::before {
    top: 0;
    left: 0;
    border-width: 2px 0 0 2px;
  }
  .stage::after {
    bottom: 0;
    right: 0;
    border-width: 0 2px 2px 0;
  }
  .stage .c3 {
    top: 0;
    right: 0;
    border-width: 2px 2px 0 0;
  }
  .stage .c4 {
    bottom: 0;
    left: 0;
    border-width: 0 0 2px 2px;
  }

  /* readout slates */
  .slate,
  .log {
    position: relative;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    min-width: 0;
  }

  .slate::before,
  .slate::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--label);
    border-style: solid;
  }

  .slate::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .slate::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .slate h2,
  .log h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--label);
    line-height: 1.4;
  }

  .slate h2::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent);
    box-shadow: var(--glow-small);
  }

  dl {
    display: grid;
    gap: 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    color: var(--accent);
    white-space: nowrap;
    text-shadow: var(--glow-text);
  }

  .slate a {
    color: var(--accent);
    text-decoration: none;
  }

  .slate a:hover {
    text-decoration: underline;
  }

  /* the nodes panel is the one link into the page: it leads to the pillars it counts */
  .nodes a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-shadow: var(--glow-text);
  }

  .nodes a::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--accent);
    box-shadow: var(--glow-small);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .nodes a::after {
    content: '→';
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .ticker {
    height: 1.5em;
    overflow: hidden;
  }

  .ticker ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker.four ul {
    animation: tick4 12s steps(4) infinite;
  }

  .ticker.six ul {
    animation: tick6 18s steps(6) infinite;
  }

  .ticker li {
    height: 1.5em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text);
  }

  .ticker b {
    font-weight: 400;
    color: var(--accent);
  }

  @keyframes tick4 {
    to {
      transform: translateY(-6em);
    }
  }

  @keyframes tick6 {
    to {
      transform: translateY(-9em);
    }
  }

  .gauge {
    position: relative;
    height: 58px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    padding: 1.1rem 0.8rem 0.45rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .gauge::before {
    content: attr(data-l);
    position: absolute;
    top: 0.3rem;
    left: 0.8rem;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .gauge i {
    flex: 1;
    height: 100%;
    background: var(--bar);
    opacity: 0.75;
    transform-origin: bottom;
    animation: eq 1.9s ease-in-out infinite alternate;
  }

  /* staggered phases without a per-bar style */
  .gauge i:nth-child(4n + 1) {
    animation-duration: 1.4s;
  }
  .gauge i:nth-child(4n + 2) {
    animation-duration: 1.65s;
  }
  .gauge i:nth-child(4n + 3) {
    animation-duration: 1.9s;
  }
  .gauge i:nth-child(4n) {
    animation-duration: 2.15s;
  }
  .gauge i:nth-child(5n + 1) {
    animation-delay: -0.1s;
  }
  .gauge i:nth-child(5n + 2) {
    animation-delay: -0.5s;
  }
  .gauge i:nth-child(5n + 3) {
    animation-delay: -0.9s;
  }
  .gauge i:nth-child(5n + 4) {
    animation-delay: -1.3s;
  }
  .gauge i:nth-child(5n) {
    animation-delay: -1.7s;
  }
  .gauge i:nth-child(6n) {
    background: var(--bar-alt);
  }

  @keyframes eq {
    from {
      transform: scaleY(0.15);
    }
    to {
      transform: scaleY(1);
    }
  }

  .log {
    border-left: 3px solid var(--accent);
    font-size: 0.72rem;
    line-height: 1.6;
  }

  .log ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .log li {
    display: flex;
    gap: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    animation: show 1ms linear forwards;
  }

  .log li:nth-child(1) {
    animation-delay: 0.6s;
  }
  .log li:nth-child(2) {
    animation-delay: 0.76s;
  }
  .log li:nth-child(3) {
    animation-delay: 0.92s;
  }
  .log li:nth-child(4) {
    animation-delay: 1.08s;
  }
  .log li:nth-child(5) {
    animation-delay: 1.24s;
  }
  .log li:nth-child(6) {
    animation-delay: 1.4s;
  }

  .log li::before {
    content: '>';
    color: var(--label);
  }

  .log .d {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--border-strong);
  }

  .log .v {
    color: var(--accent);
    text-shadow: var(--glow-text);
  }

  .log li:last-child .v::after {
    content: '▌';
    margin-left: 0.2rem;
    animation: blink 1s steps(2) infinite;
  }

  @keyframes show {
    to {
      opacity: 1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ── bottom row ──────────────────────────────────────── */
  .tape,
  .notice {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--border);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .tape {
    height: 44px;
  }

  .strip {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    display: flex;
    animation: tape 80s linear infinite;
  }

  .seg {
    flex: none;
    display: flex;
    width: 2400px;
    height: 100%;
    background:
      repeating-linear-gradient(90deg, var(--border-strong) 0 1px, transparent 1px 20px) 0 100% / 100% 8px no-repeat,
      repeating-linear-gradient(90deg, var(--label) 0 2px, transparent 2px 100px) 0 100% / 100% 16px no-repeat;
  }

  /* each numeral sits in a 100px box centred on its major tick */
  .seg span {
    flex: none;
    width: 100px;
    padding-top: 6px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .seg span:first-child {
    margin-left: -50px;
  }

  @keyframes tape {
    from {
      transform: translateX(-2400px);
    }
    to {
      transform: translateX(-4800px);
    }
  }

  .tape::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
    box-shadow: var(--glow-small);
  }

  .tape::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 0;
    height: 0;
    margin-left: -7px;
    border: 7px solid transparent;
    border-top: 8px solid var(--accent);
    z-index: 1;
  }

  .notice {
    padding: 0.45rem 0;
    background: var(--surface);
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    text-shadow: var(--glow-text);
  }

  .notice div {
    display: inline-block;
    white-space: nowrap;
    animation: marquee 50s linear infinite;
  }

  .notice span {
    padding-right: 3.5rem;
  }

  .notice span::before {
    content: '//';
    margin-right: 0.8rem;
    color: var(--text-muted);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 960px) {
    .top {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.4rem;
    }

    .cells.right {
      justify-content: center;
    }

    .mid {
      grid-template-columns: 1fr;
    }

    .stage {
      order: -1;
    }

    .col {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .col .log {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .col {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud,
    .cell,
    .nodes a::before,
    .banner strong,
    .ticker ul,
    .gauge i,
    .log li,
    .log li:last-child .v::after,
    .strip,
    .notice div {
      animation: none;
    }

    .log li {
      opacity: 1;
    }

    .gauge i {
      transform: scaleY(0.5);
    }

    .strip {
      transform: translateX(-2400px);
    }
  }
</style>
