---
import { Icon } from 'astro-icon/components';
import copy from '../content/copy.yml';

const icons: Record<string, string[]> = {
  community: ['lucide:users', 'lucide:messages-square', 'lucide:heart-handshake'],
  software: ['lucide:git-branch', 'lucide:container', 'lucide:terminal'],
  services: ['lucide:server', 'lucide:globe', 'lucide:activity'],
  knowledge: ['lucide:book-open', 'lucide:pen-line', 'lucide:video'],
};
---

<section id="pillars" class="pillars">
  <div class="wrap">
    <h2 data-reveal>{copy.pillars.heading}</h2>
    <p class="intro" data-reveal>{copy.pillars.intro}</p>
    <div class="grid">
      {
        copy.pillars.items.map((item: { id: string; title: string; body: string }) => (
          <article class="card" data-reveal>
            <p class="tag">{item.title}</p>
            <div class="icons">
              {icons[item.id]?.map((name) => (
                <span class="chip">
                  <Icon name={name} />
                </span>
              ))}
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    padding-block: var(--space-3xl);
  }

  h2 {
    font-size: var(--step-3);
    text-align: center;
  }

  .intro {
    max-width: 58ch;
    margin: var(--space-m) auto 0;
    text-align: center;
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  /* four cards in two rows of two, so each keeps a comfortable measure */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    margin-top: var(--space-2xl);
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* stagger the card reveals */
  .grid > :nth-child(2) {
    --reveal-delay: 100ms;
  }

  .grid > :nth-child(3) {
    --reveal-delay: 200ms;
  }

  .grid > :nth-child(4) {
    --reveal-delay: 300ms;
  }

  .card {
    position: relative;
    padding: var(--space-xl);
    border: 1px solid var(--border);
    background: var(--surface);
    min-width: 0;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .card::before,
  .card::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--label);
    border-style: solid;
  }

  .card::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }

  .card::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-pixel);
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--label);
  }

  .tag::before {
    content: '';
    width: 10px;
    height: 10px;
    border: 2px solid var(--accent);
    transform: rotate(45deg);
    flex: none;
  }

  .card h3 {
    font-size: var(--step-2);
    margin-top: var(--space-m);
  }

  .card p:last-child {
    margin-top: var(--space-s);
    color: var(--text-muted);
  }

  .icons {
    display: flex;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  .chip {
    display: inline-flex;
    padding: 0.55rem;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  /* the icon trio hops in sequence when the card is hovered */
  .card:hover .chip {
    transform: translateY(-4px);
  }

  .card:hover .chip:nth-child(2),
  .chip:nth-child(2) {
    transition-delay: 60ms;
  }

  .card:hover .chip:nth-child(3),
  .chip:nth-child(3) {
    transition-delay: 120ms;
  }

  .chip:nth-child(2) {
    color: var(--accent-2);
  }

  .chip:nth-child(3) {
    color: var(--accent-3);
  }

  .chip [data-icon] {
    width: 1.35rem;
    height: 1.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:hover .chip {
      transform: none;
    }
  }
</style>
