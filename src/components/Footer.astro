---
import copy from '../content/copy.yml';
import { site } from '../config/site';
---

<footer>
  <div class="wrap inner">
    <p class="motto">{copy.footer.motto}</p>
    <a class="kofi" href={site.kofi} rel="noopener noreferrer"><span>{copy.footer.kofi}</span></a>
    <p class="credit">
      {copy.footer.creditBefore}<span class="heart">❤</span>{copy.footer.creditAfter}<a
        href={site.author.url}
        rel="noopener noreferrer">{site.author.name}</a
      >
    </p>
    <nav class="legal" aria-label={copy.footer.legal}>
      <a href="/privacy/">{copy.footer.privacy}</a>
      <a href="/terms/">{copy.footer.terms}</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    position: relative;
    border-top: 1px solid var(--border);
    padding-block: var(--space-xl);
  }

  /* tick marks along the top edge, like the compass tape */
  footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 7px;
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 1px, transparent 1px 14px);
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    text-align: center;
  }

  .motto {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.01em;
  }

  .motto::before {
    content: '// ';
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--accent);
  }

  /* a smaller chamfered button than the hero's */
  .kofi {
    --cut: 9px;
    display: inline-block;
    padding: 1px;
    background: var(--border-strong);
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%,
      0 var(--cut)
    );
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .kofi > span {
    display: block;
    padding: 0.6rem 1.1rem;
    background: var(--bg-raised);
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%,
      0 var(--cut)
    );
  }

  .kofi:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }

  .credit a,
  .legal a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .credit a:hover,
  .legal a:hover {
    color: var(--accent);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-l);
    font-size: var(--step--1);
  }

  .credit {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .heart {
    color: var(--accent-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .kofi:hover {
      transform: none;
    }
  }
</style>
