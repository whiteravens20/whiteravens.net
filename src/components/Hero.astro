---
import Hud from './Hud.astro';
import copy from '../content/copy.yml';
import { site } from '../config/site';
---

<header class="hero">
  <div class="wrap">
    <Hud />
  </div>
  <div class="intro wrap">
    <p class="eyebrow">{copy.hero.eyebrow}</p>
    <h1 class="title">{copy.hero.title}</h1>
    <p class="tagline">{copy.hero.tagline}</p>
    <div class="ctas">
      <a class="btn btn-primary" href={site.docs} rel="noopener noreferrer"><span>{copy.hero.ctaDocs} ↗</span></a>
      <a class="btn" href={site.blog} rel="noopener noreferrer"><span>{copy.hero.ctaBlog}</span></a>
      <a class="btn" href={site.github} rel="noopener noreferrer"><span>{copy.hero.ctaGithub}</span></a>
    </div>
  </div>
</header>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
    text-align: center;
  }

  .hero > .wrap {
    max-width: 82rem;
  }

  .intro {
    display: grid;
    justify-items: center;
    gap: var(--space-l);
    margin-top: var(--space-2xl);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .eyebrow::before {
    content: '// ';
  }

  .title {
    font-size: var(--step-5);
    font-weight: 700;
    letter-spacing: -0.02em;
    /* sheen band layered over the brand gradient; only the band's position animates */
    background:
      linear-gradient(100deg, transparent 44%, var(--title-sheen) 50%, transparent 56%) no-repeat,
      linear-gradient(100deg, var(--heading) 55%, var(--accent));
    background-size:
      250% 100%,
      100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 8s var(--ease) infinite;
  }

  @keyframes sheen {
    0%,
    55% {
      background-position:
        115% 0,
        0 0;
    }
    100% {
      background-position:
        -35% 0,
        0 0;
    }
  }

  .tagline {
    max-width: 46ch;
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-xs);
  }

  /* chamfered buttons: the outer element paints the border, the inner one the face */
  .btn {
    --cut: 11px;
    display: inline-block;
    padding: 1px;
    background: var(--border-strong);
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%,
      0 var(--cut)
    );
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      background var(--dur-fast) var(--ease);
  }

  .btn > span {
    display: block;
    padding: 0.85rem 1.5rem;
    background: var(--bg-raised);
    clip-path: polygon(
      var(--cut) 0,
      100% 0,
      100% calc(100% - var(--cut)),
      calc(100% - var(--cut)) 100%,
      0 100%,
      0 var(--cut)
    );
  }

  .btn:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .btn-primary > span {
    background: var(--accent);
  }

  .btn-primary:hover {
    box-shadow: var(--glow-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .title {
      animation: none;
    }

    .btn:hover {
      transform: none;
    }
  }
</style>
